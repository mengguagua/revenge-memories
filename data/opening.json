  "dialogues": {
    "training": [
      {
        "speaker": "mycen",
        "face": "mycen",
        "text_ja": "アルム ひとやすみしよう",
        "source_label": "L039770",
        "text_zh": "阿尔姆，休息一下吧。"
      },
      {
        "speaker": "mycen",
        "face": "mycen",
        "text_ja": "けんのしゅぎょうは おわりだ\nもう あそびにいってもいいぞ",
        "source_label": "L039770",
        "text_zh": "今天的剑术修行就到这里。你可以去玩了。"
      },
      {
        "speaker": "mycen",
        "face": "mycen",
        "text_ja": "だが むらのそとへは ゆくな",
        "source_label": "L039770",
        "text_zh": "不过，不许到村子外面去。"
      },
      {
        "speaker": "mycen",
        "face": "mycen",
        "text_ja": "さいきんは このへんにも\nさんぞくが うろついてるからな",
        "source_label": "L039770",
        "text_zh": "最近，连这附近也有山贼出没。"
      }
    ],
    "friends_greeting": [
      {
        "speaker": "",
        "face": "",
        "text_ja": "やあ アルム\nいいところにきたな",
        "source_label": "L0397D9",
        "text_zh": "嗨，阿尔姆，你来得正好。"
      },
      {
        "speaker": "",
        "face": "",
        "text_ja": "おまえも このひとのはなしをきけよ",
        "source_label": "L0397D9",
        "text_zh": "你也来听听这位先生说的事吧。"
      }
    ],
    "lukas_report": [
      {
        "speaker": "lukas",
        "face": "lukas",
        "text_ja": "あの あくめいたかい\nドゼーしょうぐんが ついに\nクーデターを おこしたのです",
        "source_label": "L0397FE",
        "text_zh": "那个臭名昭著的德赛将军，终于发动了政变。"
      },
      {
        "speaker": "lukas",
        "face": "lukas",
        "text_ja": "ソフィアのしろは ドゼーぐんに\nせんりょうされ こくおうも\nころされてしまいました",
        "source_label": "L0397FE",
        "text_zh": "索菲亚城被德赛的军队占领，国王也惨遭杀害。"
      },
      {
        "speaker": "lukas",
        "face": "lukas",
        "text_ja": "ドゼーは ざんぎゃくなおとこで\nまいにち おおくのひとたちが\nひどいめに あっている",
        "source_label": "L0397FE",
        "text_zh": "德赛是个残暴的人。每天都有许多人遭受他的迫害。"
      },
      {
        "speaker": "lukas",
        "face": "lukas",
        "text_ja": "ぼくたちは かいほうぐんをつくって\nドゼーと たたかっているのですが\nざんねんながら うまくいきません",
        "source_label": "L0397FE",
        "text_zh": "我们组织了解放军，与德赛作战。可惜，战况一直不顺利。"
      },
      {
        "speaker": "lukas",
        "face": "lukas",
        "text_ja": "それで マイセンしょうぐんの\nおちからを かりに きたのです",
        "source_label": "L0397FE",
        "text_zh": "所以，我来这里，是想请麦森将军助我们一臂之力。"
      }
    ],
    "kliff_reaction": [
      {
        "speaker": "kliff",
        "face": "kliff",
        "text_ja": "へぇー おまえのじいちゃんって\nむかしは しょうぐんだったのか",
        "source_label": "L0398F4",
        "text_zh": "哎，你爷爷以前居然是个将军啊？"
      }
    ],
    "tobin_encouragement": [
      {
        "speaker": "tobin",
        "face": "tobin",
        "text_ja": "なあ アルム\nくにの みんなが こまってるんだ\nみんなで たすけにいこうぜ",
        "source_label": "L039918",
        "text_zh": "阿尔姆，全国的人都在受苦。我们一起去帮他们吧！"
      }
    ],
    "gray_advice": [
      {
        "speaker": "gray",
        "face": "gray",
        "text_ja": "おれたちは ここでまってるから\nじいちゃんに たのんでみろよ",
        "source_label": "L039943",
        "text_zh": "我们在这里等你，你去求求爷爷吧。"
      }
    ],
    "mycen_refusal": [
      {
        "speaker": "mycen",
        "face": "mycen",
        "text_ja": "なに かいほうぐんにはいるだと!",
        "source_label": "L039966",
        "text_zh": "什么？你说要加入解放军！"
      },
      {
        "speaker": "mycen",
        "face": "mycen",
        "text_ja": "だめだ.ゆるさん!!",
        "source_label": "L039966",
        "text_zh": "不行！我绝不允许！"
      },
      {
        "speaker": "mycen",
        "face": "mycen",
        "text_ja": "おまえは たたかってはならぬ\nかなしいおもいを するだけだ",
        "source_label": "L039966",
        "text_zh": "你不能去战斗，那只会让你伤心。"
      }
    ],
    "alm_volunteers": [
      {
        "speaker": "lukas",
        "face": "lukas",
        "text_ja": "だめでしたか··ざんねんです",
        "source_label": "L0399AF",
        "text_zh": "他不肯答应吗……真遗憾。"
      },
      {
        "speaker": "lukas",
        "face": "lukas",
        "text_ja": "マイセンどのも としをとられて\nおくびょうに なられたのですね",
        "source_label": "L0399AF",
        "text_zh": "看来麦森将军上了年纪，也变得胆怯了。"
      },
      {
        "speaker": "lukas",
        "face": "lukas",
        "text_ja": "かつては ソフィアいちの\nゆうしゃとして こくみんから\nそんけいされていたのに···",
        "source_label": "L0399AF",
        "text_zh": "他曾是索菲亚最出色的勇士，深受国民敬重啊……"
      },
      {
        "speaker": "alm",
        "face": "alm",
        "text_ja": "まって じいちゃんのかわりに\nぼくが かいほうぐんにはいるよ",
        "source_label": "L0399AF",
        "text_zh": "等等！我替爷爷加入解放军！"
      },
      {
        "speaker": "lukas",
        "face": "alm",
        "text_ja": "えっ! \nきみが マイセンしょうぐんの\nかわりに きてくれるのか",
        "source_label": "L0399AF",
        "text_zh": "什么！你愿意代替麦森将军，跟我们一起去吗？"
      },
      {
        "speaker": "lukas",
        "face": "alm",
        "text_ja": "ありがとう.なかまたちも\nきっと よろこぶよ",
        "source_label": "L0399AF",
        "text_zh": "谢谢你！伙伴们也一定会很高兴。"
      },
      {
        "speaker": "lukas",
        "face": "alm",
        "text_ja": "じゃあ ぼくといっしょに\nかいほうぐんのアジトまでいこう",
        "source_label": "L0399AF",
        "text_zh": "那就跟我一起，去解放军的据点吧。"
      }
    ],
    "lukas_join_repeat": [
      {
        "speaker": "lukas",
        "face": "lukas",
        "text_ja": "ありがとう.なかまたちも\nきっと よろこぶよ",
        "source_label": "L039A69",
        "text_zh": "谢谢你！伙伴们也一定会很高兴。"
      },
      {
        "speaker": "lukas",
        "face": "lukas",
        "text_ja": "じゃあ ぼくといっしょに\nかいほうぐんのアジトまでいこう",
        "source_label": "L039A69",
        "text_zh": "那就跟我一起，去解放军的据点吧。"
      }
    ],
    "gray_joins": [
      {
        "speaker": "gray",
        "face": "gray",
        "text_ja": "アルム ぼくもゆくよ",
        "source_label": "L039AA6",
        "text_zh": "阿尔姆，我也去。"
      },
      {
        "speaker": "gray",
        "face": "gray",
        "text_ja": "このラムのむらだって\nいつかは おそわれるはずだろ",
        "source_label": "L039AA6",
        "text_zh": "这座拉姆村，迟早也会遭到袭击吧？"
      },
      {
        "speaker": "gray",
        "face": "gray",
        "text_ja": "それなら さきに\nそのドゼーとかいうやつを\nやっつけちまおうぜ",
        "source_label": "L039AA6",
        "text_zh": "既然这样，我们先去打倒那个叫德赛的家伙！"
      }
    ],
    "tobin_joins": [
      {
        "speaker": "tobin",
        "face": "tobin",
        "text_ja": "アルムは おれたちのリーダーだろ\nもちろん ひとりでゆかせないぜ",
        "source_label": "L039AFB",
        "text_zh": "阿尔姆，你可是我们的领头人。我们当然不能让你一个人去！"
      },
      {
        "speaker": "tobin",
        "face": "tobin",
        "text_ja": "いっしょに ソフィアのしろを\nとりもどそう",
        "source_label": "L039AFB",
        "text_zh": "一起夺回索菲亚城吧！"
      }
    ],
    "kliff_joins": [
      {
        "speaker": "kliff",
        "face": "kliff",
        "text_ja": "おれ!?·· どうしょうかな··",
        "source_label": "L039B3F",
        "text_zh": "我！？……让我想想……"
      },
      {
        "speaker": "kliff",
        "face": "kliff",
        "text_ja": "まぁいいや,いっしょにゆくよ",
        "source_label": "L039B3F",
        "text_zh": "好吧，我也跟你们一起去。"
      },
      {
        "speaker": "kliff",
        "face": "kliff",
        "text_ja": "だけど あぶなくなったら\nたすけてくれよ",
        "source_label": "L039B3F",
        "text_zh": "不过，遇到危险的时候，可一定要救我啊。"
      },
      {
        "speaker": "kliff",
        "face": "kliff",
        "text_ja": "おれたちは おまえとはちがって\nまだ うまくたたかえないからな",
        "source_label": "L039B3F",
        "text_zh": "我们不像你，还不太会战斗呢。"
      }
    ]
  },
