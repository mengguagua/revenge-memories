# Godot 导入缓存和本地参考文件（保留资源旁的 .import / .uid）
.godot/
.reference/
/tools/graphics/asset_manifest.*.translation

# Python 与本地工具缓存、虚拟环境
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.venv/
venv/

# macOS 元数据、日志和编辑器临时文件
.DS_Store
._*
*.log
*.tmp
*.temp
*.swp
*.swo
*~

# 测试 / 截图存档及迁移备份，保留 verification 报告
/reports/*save.json
/reports/*save.json.*
/reports/test-save-*.json
/reports/test-save-*.json.*

# reports 仅作验收证据；截图不作为运行资源导入
/reports/**/*.import

# 打包产物
/dist/
*.pck
*.app/
*.ipa
/officialWebsite/dist/

# 本机安装、签名及打包验收记录
/actual/reports/iphone-install-*/
/actual/reports/mac-package-*/

# 音频制作原稿和本地试听产物；游戏运行音频在 actual/assets/
/source/audio-20261024/**/*.wav
/source/sfx-20261024/**/*.wav
/actual/reports/soundtrack-20261024/audition/
/actual/reports/sfx-20261024/audition/
/actual/reports/audio-scene-review-20261024/audition/
/actual/reports/audio-content-review-20261024/inputs/
/actual/reports/audio-content-review-20261024/native-engine-mix.wav

# 未压缩的本地对照快照，保留压缩版和正式验收记录
/art-review/character-expansion-20261018/**/baseline.json
/actual/reports/full-playtest-20261023/start-numeric-data.json
