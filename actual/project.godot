; Independent reconstruction workspace; world art approval milestone.
config_version=5

[application]
config/name="revenge-memories · 序章至第三章"
config/version="0.8.11"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/use_custom_user_dir=true
config/custom_user_dir_name="revenge-memories-actual-campaign"

[display]
window/size/viewport_width=256
window/size/viewport_height=240
window/size/window_width_override=1704
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/stretch/scale_mode="integer"
window/handheld/orientation=4

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.035, 0.106, 0.137, 1)

[debug]
gdscript/warnings/integer_division=0
