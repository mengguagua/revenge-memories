  "dialogue": [
    {
      "scene": "D00",
      "speaker": "胡纳普",
      "text": "……艾琳？把绳子解开。",
      "emotion": "concern"
    },
    {
      "scene": "D00",
      "speaker": "胡纳普",
      "text": "你先告诉我发生了什么。",
      "emotion": "firm"
    },
    {
      "scene": "D11",
      "speaker": "胡纳普",
      "text": "名字还没刻完。",
      "emotion": "grief"
    },
    {
      "scene": "D11",
      "speaker": "胡纳普",
      "text": "科兰回旧塔堡了。我明天走。",
      "emotion": "resolve"
    },
    {
      "scene": "D11",
      "speaker": "胡纳普",
      "text": "……我先送他们出去。你把弓带上。",
      "emotion": "resolve"
    },
    {
      "scene": "D12",
      "speaker": "胡纳普",
      "text": "科兰扣了粮，还把领粮的人抓走了。",
      "emotion": "anger"
    },
    {
      "scene": "D12",
      "speaker": "胡纳普",
      "text": "我会去旧塔堡。我要他说明凯尔的事。",
      "emotion": "resolve"
    },
    {
      "scene": "D13",
      "speaker": "胡纳普",
      "text": "凯尔回营的时候，你答应过放人。",
      "emotion": "resolve"
    },
    {
      "scene": "D13",
      "speaker": "胡纳普",
      "text": "所以你把他挂在营门外。",
      "emotion": "anger"
    }
  ],
  "story_relation": "凯尔是胡纳普的兄长；D11悲伤表情对应刻兄长纪念碑。"
