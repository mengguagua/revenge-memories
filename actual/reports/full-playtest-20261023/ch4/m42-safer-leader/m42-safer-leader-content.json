[
  {
    "code": "M42",
    "kind": "dialogue_or_objective",
    "speaker": "胡纳普",
    "stage": 402,
    "text": "投送站还在往群岛运兵。先\n截断这里，再进北境。",
    "turn": 1
  },
  {
    "code": "M42",
    "kind": "dialogue_or_objective",
    "speaker": "兰斯",
    "stage": 402,
    "text": "营地西侧有人曾与我共事。\n让我到他旁边谈谈。",
    "turn": 1
  },
  {
    "code": "M42",
    "kind": "dialogue_or_objective",
    "speaker": "胡纳普",
    "stage": 402,
    "text": "可以，但别一个人走进弓手\n面前。",
    "turn": 1
  },
  {
    "code": "M42",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 402,
    "text": "控制投送站并击败铁骑统领。首领有橙\n色旗标。S菜单可定位首领。",
    "turn": 1
  },
  {
    "code": "M42",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 402,
    "text": "控制投送站并击败铁骑统领。",
    "turn": 1
  },
  {
    "code": "M42",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 402,
    "text": "切断神术投送站：未完成",
    "turn": 1
  },
  {
    "code": "M42",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 402,
    "text": "西北岩坡与中央密林夹出骑兵军道，东\n侧投送营以完整木栅围合，南北主门连\n大道，西门接林缘旧营。",
    "turn": 1
  },
  {
    "code": "M42",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 402,
    "text": "兰斯的旧同袍退至西营后方住舍旁，部\n署当轮可到邻格交涉，再沿西路从营侧\n进入；主道利于骑兵展开，林路更窄且",
    "turn": 1
  },
  {
    "code": "M42",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 402,
    "text": "需绕开树丛。",
    "turn": 1
  },
  {
    "code": "M42",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 402,
    "text": "投送装置、库房和东骑兵营各有装卸/巡\n行通路，第5回合东南来援保持；旧同袍\n转中立与切断投送规则不变。",
    "turn": 1
  },
  {
    "code": "M42",
    "kind": "dialogue_or_objective",
    "speaker": "兰斯",
    "stage": 402,
    "text": "投送过去的军队会把船上的\n人赶回海里。交出武器，留\n下来作证。",
    "turn": 1
  },
  {
    "code": "M42",
    "kind": "dialogue_or_objective",
    "speaker": "旧同袍",
    "stage": 402,
    "text": "我们这一队停手。统领还在\n北营，不肯接受。",
    "turn": 1
  },
  {
    "code": "M42",
    "kind": "dialogue_or_objective",
    "speaker": "斥候",
    "stage": 402,
    "text": "后方路口有援军。下一回合\n抵达，只有这一队。",
    "turn": 4
  },
  {
    "code": "M42",
    "kind": "dialogue_or_objective",
    "speaker": "工匠",
    "stage": 402,
    "text": "投送已停止。信件送往东\n岸，已抵达的敌军不会因此\n消失。",
    "turn": 10
  },
  {
    "code": "M42",
    "kind": "dialogue_or_objective",
    "speaker": "信使",
    "stage": 402,
    "text": "投送站停止的消息已发往东\n岸。若祭所战斗已经结束，\n这封信会保护后面的船队。",
    "turn": 17
  },
  {
    "code": "M42",
    "kind": "dialogue_or_objective",
    "speaker": "旁白",
    "stage": 402,
    "text": "战后整理出银枪，已收入本队行囊，可\n在部队整备中分配。",
    "turn": 17
  },
  {
    "code": "M42",
    "kind": "dialogue_or_objective",
    "speaker": "工匠",
    "stage": 402,
    "text": "投送站已停止。北境日塔还\n依赖现有设备，先夺取控制\n室，等观测台给出步骤再停",
    "turn": 17
  },
  {
    "code": "M42",
    "kind": "dialogue_or_objective",
    "speaker": "工匠",
    "stage": 402,
    "text": "用。",
    "turn": 17
  },
  {
    "code": "M42",
    "kind": "dialogue_or_objective",
    "speaker": "信使",
    "stage": 402,
    "text": "东岸的信按战前军情登记。\n已经落地的敌军仍需应对，\n之后的船队也会因此少受一",
    "turn": 17
  },
  {
    "code": "M42",
    "kind": "dialogue_or_objective",
    "speaker": "信使",
    "stage": 402,
    "text": "次拦截。",
    "turn": 17
  },
  {
    "code": "M42",
    "kind": "dialogue_or_objective",
    "speaker": "达恩",
    "stage": 402,
    "text": "我用自己的零钱买了些布和\n纸。请替我送给米蕾，她一\n直在找干净的。",
    "turn": 17
  },
  {
    "code": "M42",
    "kind": "dialogue_or_objective",
    "speaker": "信使",
    "stage": 402,
    "text": "收到。你写的这几行也放进\n去？",
    "turn": 17
  },
  {
    "code": "M42",
    "kind": "dialogue_or_objective",
    "speaker": "达恩",
    "stage": 402,
    "text": "放进去。告诉她，我还在学\n那些店名。",
    "turn": 17
  },
  {
    "code": "M42",
    "kind": "dialogue_or_objective",
    "speaker": "兰斯",
    "stage": 402,
    "text": "给家属的信我先送。蕾娜还\n在照护处，请把她的近况单\n独写清楚。",
    "turn": 17
  },
  {
    "code": "M42",
    "kind": "dialogue_or_objective",
    "speaker": "信使",
    "stage": 402,
    "text": "会按伤情写，不会把她当作\n遇难者。",
    "turn": 17
  }
]