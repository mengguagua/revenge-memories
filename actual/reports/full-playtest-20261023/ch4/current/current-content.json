[
  {
    "code": "M41",
    "kind": "dialogue_or_objective",
    "speaker": "奥托",
    "stage": 401,
    "text": "北村的人沿村道向南撤。先\n疏通南口，再去接山道上的\n伤者。",
    "turn": 1
  },
  {
    "code": "M41",
    "kind": "dialogue_or_objective",
    "speaker": "胡纳普",
    "stage": 401,
    "text": "我们挡住封路的人，至少带\n回两组居民。",
    "turn": 1
  },
  {
    "code": "M41",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 401,
    "text": "疏通南口与停靠点，撤离至少两组居民\n并击败指挥官。出口有旗标。S菜单可定\n位出口与首领。",
    "turn": 1
  },
  {
    "code": "M41",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 401,
    "text": "疏通南口与停靠点，撤离至少两组居民\n并击败指挥官。",
    "turn": 1
  },
  {
    "code": "M41",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 401,
    "text": "已撤离0组；至少2组。居民遇敌等待，\n请清出连续通路；组别生死分别保存。",
    "turn": 1
  },
  {
    "code": "M41",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 401,
    "text": "疏通南口路障：未完成",
    "turn": 1
  },
  {
    "code": "M41",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 401,
    "text": "安置伤者停靠点：未完成",
    "turn": 1
  },
  {
    "code": "M41",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 401,
    "text": "西北四座村舍围出紧凑村街，融雪河从\n东北斜向西南切开雪峡；中央主桥连接\n村街和东岸医舍，南口在两侧山肩与木",
    "turn": 1
  },
  {
    "code": "M41",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 401,
    "text": "障之间收窄。",
    "turn": 1
  },
  {
    "code": "M41",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 401,
    "text": "主桥可集中兵力正面破阵；东北林缘的\n一格小桥较长、较窄，能绕至桥头守军\n侧后。两线在医舍前重新汇合，沿途保",
    "turn": 1
  },
  {
    "code": "M41",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 401,
    "text": "留雪地展开空间与林缘地形。",
    "turn": 1
  },
  {
    "code": "M41",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 401,
    "text": "北口第4敌方回合仍有两名骑兵追来。保\n护北村居民与山道伤者过桥，同时接应\n南村居民；疏通南口、确认医舍停靠",
    "turn": 1
  },
  {
    "code": "M41",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 401,
    "text": "点、撤离至少两组并击败指挥官的规则\n不变。",
    "turn": 1
  },
  {
    "code": "M41",
    "kind": "dialogue_or_objective",
    "speaker": "斥候",
    "stage": 401,
    "text": "后方路口有援军。下一回合\n抵达，只有这一队。",
    "turn": 3
  },
  {
    "code": "M41",
    "kind": "dialogue_or_objective",
    "speaker": "居民",
    "stage": 401,
    "text": "接应的人到了。我们先到安\n全处等候。",
    "turn": 14
  },
  {
    "code": "M41",
    "kind": "dialogue_or_objective",
    "speaker": "居民",
    "stage": 401,
    "text": "活着的组别和伤亡分别登\n记。先到南口安置处确认，\n再沿山道去铁骑关。",
    "turn": 14
  },
  {
    "code": "M41",
    "kind": "dialogue_or_objective",
    "speaker": "旁白",
    "stage": 401,
    "text": "战后整理出钢盾，已收入本队行囊，可\n在部队整备中分配。",
    "turn": 14
  },
  {
    "code": "M41",
    "kind": "dialogue_or_objective",
    "speaker": "医者",
    "stage": 401,
    "text": "登记了3组存活居民。遇难的\n人另记姓名，不会从名册上\n划掉。铁骑关的道路已标出",
    "turn": 14
  },
  {
    "code": "M41",
    "kind": "dialogue_or_objective",
    "speaker": "医者",
    "stage": 401,
    "text": "来。",
    "turn": 14
  },
  {
    "code": "M41",
    "kind": "dialogue_or_objective",
    "speaker": "奥托",
    "stage": 401,
    "text": "我以前也照命令封过这条\n路。那时我说只负责守口，\n没有问留下的人怎么活。",
    "turn": 14
  },
  {
    "code": "M41",
    "kind": "dialogue_or_objective",
    "speaker": "胡纳普",
    "stage": 401,
    "text": "我借日塔保护了这些村庄，\n却一直没问过另一岸发生了\n什么。先把他们安置好，再",
    "turn": 14
  },
  {
    "code": "M41",
    "kind": "dialogue_or_objective",
    "speaker": "胡纳普",
    "stage": 401,
    "text": "去关口。",
    "turn": 14
  },
  {
    "code": "M41",
    "kind": "dialogue_or_objective",
    "speaker": "村民",
    "stage": 401,
    "text": "黑钟村正在烧失踪者名册，\n旧军令里有凯尔和奥托的名\n字。支路从雪峡村分出去。",
    "turn": 14
  },
  {
    "code": "M41",
    "kind": "dialogue_or_objective",
    "speaker": "保管人",
    "stage": 401,
    "text": "在烧毁前保护名册，再确认\n避难院并击败焚毁队长；战\n后回黑钟村避难院找我，可",
    "turn": 14
  },
  {
    "code": "M41",
    "kind": "dialogue_or_objective",
    "speaker": "保管人",
    "stage": 401,
    "text": "领取续愿戒。名册会保留凯\n尔执行错误命令的记录。",
    "turn": 14
  },
  {
    "code": "M42",
    "kind": "dialogue_or_objective",
    "speaker": "胡纳普",
    "stage": 402,
    "text": "投送站还在往群岛运兵。先\n截断这里，再进北境。",
    "turn": 1
  },
  {
    "code": "M42",
    "kind": "dialogue_or_objective",
    "speaker": "兰斯",
    "stage": 402,
    "text": "营地西侧有人曾与我共事。\n让我到他旁边谈谈。",
    "turn": 1
  },
  {
    "code": "M42",
    "kind": "dialogue_or_objective",
    "speaker": "胡纳普",
    "stage": 402,
    "text": "可以，但别一个人走进弓手\n面前。",
    "turn": 1
  },
  {
    "code": "M42",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 402,
    "text": "控制投送站并击败铁骑统领。首领有橙\n色旗标。S菜单可定位首领。",
    "turn": 1
  },
  {
    "code": "M42",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 402,
    "text": "控制投送站并击败铁骑统领。",
    "turn": 1
  },
  {
    "code": "M42",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 402,
    "text": "切断神术投送站：未完成",
    "turn": 1
  },
  {
    "code": "M42",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 402,
    "text": "西北岩坡与中央密林夹出骑兵军道，东\n侧投送营以完整木栅围合，南北主门连\n大道，西门接林缘旧营。",
    "turn": 1
  },
  {
    "code": "M42",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 402,
    "text": "兰斯的旧同袍退至西营后方住舍旁，部\n署当轮可到邻格交涉，再沿西路从营侧\n进入；主道利于骑兵展开，林路更窄且",
    "turn": 1
  },
  {
    "code": "M42",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 402,
    "text": "需绕开树丛。",
    "turn": 1
  },
  {
    "code": "M42",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 402,
    "text": "投送装置、库房和东骑兵营各有装卸/巡\n行通路，第5回合东南来援保持；旧同袍\n转中立与切断投送规则不变。",
    "turn": 1
  },
  {
    "code": "M42",
    "kind": "dialogue_or_objective",
    "speaker": "兰斯",
    "stage": 402,
    "text": "投送过去的军队会把船上的\n人赶回海里。交出武器，留\n下来作证。",
    "turn": 1
  },
  {
    "code": "M42",
    "kind": "dialogue_or_objective",
    "speaker": "旧同袍",
    "stage": 402,
    "text": "我们这一队停手。统领还在\n北营，不肯接受。",
    "turn": 1
  },
  {
    "code": "M42",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 402,
    "text": "芙拉濒死，已撤至照护处，暂时不能出\n阵。",
    "turn": 3
  },
  {
    "code": "M42",
    "kind": "dialogue_or_objective",
    "speaker": "斥候",
    "stage": 402,
    "text": "后方路口有援军。下一回合\n抵达，只有这一队。",
    "turn": 4
  },
  {
    "code": "M42",
    "kind": "dialogue_or_objective",
    "speaker": "工匠",
    "stage": 402,
    "text": "投送已停止。信件送往东\n岸，已抵达的敌军不会因此\n消失。",
    "turn": 9
  },
  {
    "code": "M42",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 402,
    "text": "胡纳普濒死，已撤至照护处，暂时不能\n出阵。",
    "turn": 9
  },
  {
    "code": "M43",
    "kind": "dialogue_or_objective",
    "speaker": "胡纳普",
    "stage": 403,
    "text": "先夺控制室，谁都别拆塔。",
    "turn": 1
  },
  {
    "code": "M43",
    "kind": "dialogue_or_objective",
    "speaker": "工匠",
    "stage": 403,
    "text": "下面还有病人。控制室缺的\n步骤在东岸观测台；可以先\n守住这里，再等来信。",
    "turn": 1
  },
  {
    "code": "M43",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 403,
    "text": "接管外院与控制室，击败塔卫统领。首\n领有橙色旗标。S菜单可定位首领。",
    "turn": 1
  },
  {
    "code": "M43",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 403,
    "text": "接管外院与控制室，击败塔卫统领。",
    "turn": 1
  },
  {
    "code": "M43",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 403,
    "text": "先完成夺塔即可返回控制室。安全停塔\n需要东队在盐原观测台取得步骤，不必\n重战。",
    "turn": 1
  },
  {
    "code": "M43",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 403,
    "text": "控制外院关卡：未完成",
    "turn": 1
  },
  {
    "code": "M43",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 403,
    "text": "接管控制室：未完成",
    "turn": 1
  },
  {
    "code": "M43",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 403,
    "text": "日塔院墙在北境岩脊间围成完整庭院，\n主楼和塔身位于北端，控制室位于东南\n角；院内积雪与石路交错，避免整片铺",
    "turn": 1
  },
  {
    "code": "M43",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 403,
    "text": "石。",
    "turn": 1
  },
  {
    "code": "M43",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 403,
    "text": "三格南门承接宽主路，西侧两格小门接\n雪林侧路；正面更直接，西侧可绕开门\n前重装但行进空间较窄。",
    "turn": 1
  },
  {
    "code": "M43",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 403,
    "text": "病人与工匠留在西南医舍侧后，避开初\n始守军射程和唯一门口；夺外院、接管\n控制室及等待东岸步骤的原流程保持。",
    "turn": 1
  },
  {
    "code": "M43",
    "kind": "dialogue_or_objective",
    "speaker": "工匠",
    "stage": 403,
    "text": "控制室归我们了。战后到这\n里核对观测步骤，不能直接\n拆塔。",
    "turn": 6
  },
  {
    "code": "M43",
    "kind": "dialogue_or_objective",
    "speaker": "工匠",
    "stage": 403,
    "text": "日塔已由我们驻守。请到控\n制室核对东岸的观测步骤；\n没收到信也不用重新作战。",
    "turn": 10
  },
  {
    "code": "M43",
    "kind": "dialogue_or_objective",
    "speaker": "旁白",
    "stage": 403,
    "text": "战后整理出银弓，已收入本队行囊，可\n在部队整备中分配。",
    "turn": 10
  },
  {
    "code": "M43",
    "kind": "dialogue_or_objective",
    "speaker": "工匠",
    "stage": 403,
    "text": "控制室由我们驻守，不必重\n打。缺少东岸盐原观测台的\n完整步骤。",
    "turn": 10
  },
  {
    "code": "M43",
    "kind": "dialogue_or_objective",
    "speaker": "提示",
    "stage": 403,
    "text": "按S切到东队，完成沙城与盐原观测台；\n信使会送来步骤，再返回本控制室确\n认。",
    "turn": 10
  },
  {
    "code": "M44",
    "kind": "dialogue_or_objective",
    "speaker": "赫兰",
    "stage": 404,
    "text": "北面那几座村庄，是你亲自\n送粮过去的。停了塔，他们\n怎么办？",
    "turn": 1
  },
  {
    "code": "M44",
    "kind": "dialogue_or_objective",
    "speaker": "胡纳普",
    "stage": 404,
    "text": "他们已经撤出来了。观测台\n的办法也试过了。",
    "turn": 1
  },
  {
    "code": "M44",
    "kind": "dialogue_or_objective",
    "speaker": "赫兰",
    "stage": 404,
    "text": "一次试成，下一次未必还能\n成。",
    "turn": 1
  },
  {
    "code": "M44",
    "kind": "dialogue_or_objective",
    "speaker": "胡纳普",
    "stage": 404,
    "text": "东边也有人这样等过你。你\n一直没有派船。",
    "turn": 1
  },
  {
    "code": "M44",
    "kind": "dialogue_or_objective",
    "speaker": "赫兰",
    "stage": 404,
    "text": "……我的人守住了西岸。我\n不能拿他们再赌一次。",
    "turn": 1
  },
  {
    "code": "M44",
    "kind": "dialogue_or_objective",
    "speaker": "投降军官",
    "stage": 404,
    "text": "留下医舍旁的后撤门，让伤\n兵退到安全处。",
    "turn": 1
  },
  {
    "code": "M44",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 404,
    "text": "占领门楼，击败并解除赫兰指挥权。首\n领有橙色旗标。S菜单可定位首领。",
    "turn": 1
  },
  {
    "code": "M44",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 404,
    "text": "占领门楼，击败并解除赫兰指挥权。",
    "turn": 1
  },
  {
    "code": "M44",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 404,
    "text": "占领王都门楼：未完成",
    "turn": 1
  },
  {
    "code": "M44",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 404,
    "text": "横贯战场的王都城墙以双塔夹出四格正\n门，城内指挥堡与医舍街、城外住区与\n军需库形成清楚前后层次。",
    "turn": 1
  },
  {
    "code": "M44",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 404,
    "text": "主街直攻门楼；西侧窄巷经过两格伤兵\n后撤门，直接接到墙内医舍，提供较慢\n但可绕过正门重装的侧通道。",
    "turn": 1
  },
  {
    "code": "M44",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 404,
    "text": "两名伤兵退到完整医舍护院内，院墙只\n留两格南门；部署靠近后撤门，两人可\n守住护院入口，其余队员沿墙后通道或",
    "turn": 1
  },
  {
    "code": "M44",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 404,
    "text": "正面推进。第4回合东南来援、赫兰半血\n对白与解除武装分支保持。",
    "turn": 1
  },
  {
    "code": "M44",
    "kind": "dialogue_or_objective",
    "speaker": "斥候",
    "stage": 404,
    "text": "后方路口有援军。下一回合\n抵达，只有这一队。",
    "turn": 3
  },
  {
    "code": "M44",
    "kind": "dialogue_or_objective",
    "speaker": "赫兰",
    "stage": 404,
    "text": "伤兵先退到医舍！后撤门留\n开。",
    "turn": 14
  },
  {
    "code": "M44",
    "kind": "dialogue_or_objective",
    "speaker": "胡纳普",
    "stage": 404,
    "text": "愿意放下武器的人，不要再\n攻击。",
    "turn": 14
  },
  {
    "code": "M44",
    "kind": "dialogue_or_objective",
    "speaker": "赫兰",
    "stage": 404,
    "text": "我交出指挥权。",
    "turn": 14
  },
  {
    "code": "M44",
    "kind": "dialogue_or_objective",
    "speaker": "胡纳普",
    "stage": 404,
    "text": "先照看你带来的伤兵。投降\n不等于此前的责任就过去\n了。",
    "turn": 14
  },
  {
    "code": "M44",
    "kind": "dialogue_or_objective",
    "speaker": "胡纳普",
    "stage": 404,
    "text": "赫兰已失去指挥权。把伤兵\n交给照护处，我们回营站核\n对两岸结果。",
    "turn": 14
  },
  {
    "code": "M44",
    "kind": "dialogue_or_objective",
    "speaker": "旁白",
    "stage": 404,
    "text": "战后整理出圣剑，已收入本队行囊，可\n在部队整备中分配。",
    "turn": 14
  },
  {
    "code": "M44",
    "kind": "dialogue_or_objective",
    "speaker": "赫兰",
    "stage": 404,
    "text": "他们跟着我守住西岸。我以\n为只要再等到大典，就能安\n排剩下的人。",
    "turn": 14
  },
  {
    "code": "M44",
    "kind": "dialogue_or_objective",
    "speaker": "胡纳普",
    "stage": 404,
    "text": "另一岸的人已经等不下去。\n你先照看伤兵，把命令和名\n单留下。",
    "turn": 14
  },
  {
    "code": "F41",
    "kind": "dialogue_or_objective",
    "speaker": "莉莎",
    "stage": 405,
    "text": "他们要把井封上。南北井台\n都留人接应，先让居民把水\n取够。",
    "turn": 1
  },
  {
    "code": "F41",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 405,
    "text": "守至第6己方回合并击败队长。敌军连续\n占井整轮才失守，可夺回；两井同时失\n守则失败。",
    "turn": 1
  },
  {
    "code": "F41",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 405,
    "text": "保住至少一井至第6己方回合，并击败强\n迁队长。首领有橙色旗标。S菜单可定位\n首领。",
    "turn": 1
  },
  {
    "code": "F41",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 405,
    "text": "保住至少一井至第6己方回合，并击败强\n迁队长。",
    "turn": 1
  },
  {
    "code": "F41",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 405,
    "text": "北井：控制中；南井：控制中。至少保\n住一井，守至第6己方回合且击败队长。",
    "turn": 1
  },
  {
    "code": "F41",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 405,
    "text": "两处井台分别围出北住区与南取水院，\n屋门、小仓院和取水巷共同构成紧凑沙\n城；井口是实体，南侧台阶才是守井目",
    "turn": 1
  },
  {
    "code": "F41",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 405,
    "text": "标。",
    "turn": 1
  },
  {
    "code": "F41",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 405,
    "text": "南井就在部署前方，可先留守；通北井\n的主巷直接但会接触守军，西住户窄巷\n更长，东后巷能侧援但受到高处弓手与",
    "turn": 1
  },
  {
    "code": "F41",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 405,
    "text": "术士威胁。",
    "turn": 1
  },
  {
    "code": "F41",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 405,
    "text": "南北well_target追井身份保持，北\n井可暂失后夺回；第3回合援兵从东北城\n关进入，至少保住一井到第6己方回合并",
    "turn": 1
  },
  {
    "code": "F41",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 405,
    "text": "击败队长的规则不变。",
    "turn": 1
  },
  {
    "code": "F41",
    "kind": "dialogue_or_objective",
    "speaker": "斥候",
    "stage": 405,
    "text": "后方路口有援军。下一回合\n抵达，只有这一队。",
    "turn": 2
  },
  {
    "code": "F41",
    "kind": "dialogue_or_objective",
    "speaker": "居民",
    "stage": 405,
    "text": "水已经取够，古道路线就在\n井台。我们会留下多份路线\n册。",
    "turn": 12
  },
  {
    "code": "F41",
    "kind": "dialogue_or_objective",
    "speaker": "旁白",
    "stage": 405,
    "text": "战后整理出银盾，已收入本队行囊，可\n在部队整备中分配。",
    "turn": 12
  },
  {
    "code": "F41",
    "kind": "dialogue_or_objective",
    "speaker": "居民",
    "stage": 405,
    "text": "南北井台的水够这一批人转\n移。古道路线已抄成几份，\n就算向导不在，也能沿标记",
    "turn": 12
  },
  {
    "code": "F41",
    "kind": "dialogue_or_objective",
    "speaker": "居民",
    "stage": 405,
    "text": "找到观测台。",
    "turn": 12
  },
  {
    "code": "F41",
    "kind": "dialogue_or_objective",
    "speaker": "艾琳",
    "stage": 405,
    "text": "留一份在井台。不要让后来\n的人再空走一趟。",
    "turn": 12
  },
  {
    "code": "F42",
    "kind": "dialogue_or_objective",
    "speaker": "艾琳",
    "stage": 406,
    "text": "记录在东楼，别让拿火把的\n人进去。先保护记录，再到\n中央设备南面复制。",
    "turn": 1
  },
  {
    "code": "F42",
    "kind": "dialogue_or_objective",
    "speaker": "地方技术员",
    "stage": 406,
    "text": "焚毁兵第6回合才出发，会先\n警告。两次连续点火才烧\n毁，我们还有时间。",
    "turn": 1
  },
  {
    "code": "F42",
    "kind": "dialogue_or_objective",
    "speaker": "地方技术员",
    "stage": 406,
    "text": "东侧的隙行术师会火球。从\n第2回合起，每隔三回合可短\n移至四格内；移形占满这次",
    "turn": 1
  },
  {
    "code": "F42",
    "kind": "dialogue_or_objective",
    "speaker": "地方技术员",
    "stage": 406,
    "text": "行动，下一轮才会攻击。",
    "turn": 1
  },
  {
    "code": "F42",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 406,
    "text": "保护东楼记录、复制设备，击败萨弥。\n首领有橙色旗标。S菜单可定位首领。",
    "turn": 1
  },
  {
    "code": "F42",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 406,
    "text": "保护东楼记录、复制设备，击败萨弥。",
    "turn": 1
  },
  {
    "code": "F42",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 406,
    "text": "焚毁兵连续两次在门前点火才毁记录。\n第6回合开始，提前一回合预告。",
    "turn": 1
  },
  {
    "code": "F42",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 406,
    "text": "保护东楼记录：未完成",
    "turn": 1
  },
  {
    "code": "F42",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 406,
    "text": "复制观测设备：未完成",
    "turn": 1
  },
  {
    "code": "F42",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 406,
    "text": "盐原观测院分为南抄录住区、中央设备\n台、东楼记录室和北值守楼，露盐地与\n小块铺石台面交错，岩脊与旧塔刻出院",
    "turn": 1
  },
  {
    "code": "F42",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 406,
    "text": "落边界。",
    "turn": 1
  },
  {
    "code": "F42",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 406,
    "text": "东侧抢救线从部署区直抵记录楼南门；\n中央主道较短但会接触萨弥前的守军，\n西岩脊维护路较窄且更长，可从侧面接",
    "turn": 1
  },
  {
    "code": "F42",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 406,
    "text": "近北庭。",
    "turn": 1
  },
  {
    "code": "F42",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 406,
    "text": "东楼对象与唯一南门操作格、burn_ta\nrget完整对应；仍须先保护记录，再在\n观测设备南面复制。第5回合预告、第6",
    "turn": 1
  },
  {
    "code": "F42",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 406,
    "text": "回合出发及连续两次点火焚毁的规则保\n持。",
    "turn": 1
  },
  {
    "code": "F42",
    "kind": "dialogue_or_objective",
    "speaker": "技术员",
    "stage": 406,
    "text": "先到东楼门前保护记录，才\n能核对设备参数。",
    "turn": 2
  },
  {
    "code": "F42",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 406,
    "text": "焚毁兵下一回合出发，目标是记录室南\n门。需要连续两次点火才能焚毁。",
    "turn": 5
  },
  {
    "code": "F42",
    "kind": "dialogue_or_objective",
    "speaker": "艾琳",
    "stage": 406,
    "text": "完整记录保住了。去中央设\n备南面核对，再把副本交给\n固定信使。",
    "turn": 13
  },
  {
    "code": "F42",
    "kind": "dialogue_or_objective",
    "speaker": "技术员",
    "stage": 406,
    "text": "断裂以前，各地的循环会互\n相调节。先隔离远端，再分\n段降流，最后核对村庄的光",
    "turn": 14
  },
  {
    "code": "F42",
    "kind": "dialogue_or_objective",
    "speaker": "技术员",
    "stage": 406,
    "text": "源。",
    "turn": 14
  },
  {
    "code": "F42",
    "kind": "dialogue_or_objective",
    "speaker": "艾琳",
    "stage": 406,
    "text": "我曾以为西岸只要停塔就\n好。现在知道，下面还有靠\n它过冬的人。",
    "turn": 14
  },
  {
    "code": "F42",
    "kind": "dialogue_or_objective",
    "speaker": "诺娅",
    "stage": 406,
    "text": "我曾把藏船的地方告诉他\n们。这次我会把完整记录交\n出来，也继续接受船团的追",
    "turn": 14
  },
  {
    "code": "F42",
    "kind": "dialogue_or_objective",
    "speaker": "诺娅",
    "stage": 406,
    "text": "问。",
    "turn": 14
  },
  {
    "code": "F42",
    "kind": "dialogue_or_objective",
    "speaker": "信使",
    "stage": 406,
    "text": "完整的停用步骤已送往北境\n日塔；祭所坐标也记下了。\n西队在控制室就能接续，不",
    "turn": 14
  },
  {
    "code": "F42",
    "kind": "dialogue_or_objective",
    "speaker": "信使",
    "stage": 406,
    "text": "必重打。",
    "turn": 14
  },
  {
    "code": "F42",
    "kind": "dialogue_or_objective",
    "speaker": "旁白",
    "stage": 406,
    "text": "战后整理出魔道戒，已收入本队行囊，\n可在部队整备中分配。",
    "turn": 14
  },
  {
    "code": "F42",
    "kind": "dialogue_or_objective",
    "speaker": "技术员",
    "stage": 406,
    "text": "停用步骤已经发给西队。祭\n所坐标在这份副本上，穿过\n亡潮沼泽就能到。",
    "turn": 14
  },
  {
    "code": "F42",
    "kind": "dialogue_or_objective",
    "speaker": "艾琳",
    "stage": 406,
    "text": "母亲没能验证完的部分，我\n们继续查。不能只因为她相\n信这条路，就让别人冒同样",
    "turn": 14
  },
  {
    "code": "F42",
    "kind": "dialogue_or_objective",
    "speaker": "艾琳",
    "stage": 406,
    "text": "的险。",
    "turn": 14
  },
  {
    "code": "F43",
    "kind": "dialogue_or_objective",
    "speaker": "船团医者",
    "stage": 407,
    "text": "有几个人走不快。把三处干\n地依次确认，再分组送往东\n北古道口。",
    "turn": 1
  },
  {
    "code": "F43",
    "kind": "dialogue_or_objective",
    "speaker": "卡洛",
    "stage": 407,
    "text": "船留在南侧接应；不要把居\n民赶进毒沼。",
    "turn": 1
  },
  {
    "code": "F43",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 407,
    "text": "西北驭魔师从第3回合起最多召唤两次，\n每次至多两名骸卫，间隔三回合；击败\n他只会清除他的召唤物。裂目兽只会分",
    "turn": 1
  },
  {
    "code": "F43",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 407,
    "text": "裂一次，子代不会再分裂，仍为近身攻\n击。",
    "turn": 1
  },
  {
    "code": "F43",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 407,
    "text": "依次确认三处干地、撤离至少两组居民\n并击败神官。出口有旗标。S菜单可定位\n出口与首领。",
    "turn": 1
  },
  {
    "code": "F43",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 407,
    "text": "依次确认三处干地、撤离至少两组居民\n并击败神官。",
    "turn": 1
  },
  {
    "code": "F43",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 407,
    "text": "已撤离0组；至少2组。居民遇敌等待，\n请清出连续通路；组别生死分别保存。",
    "turn": 1
  },
  {
    "code": "F43",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 407,
    "text": "确认第一处干地：未完成",
    "turn": 1
  },
  {
    "code": "F43",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 407,
    "text": "确认第二处干地：未完成",
    "turn": 1
  },
  {
    "code": "F43",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 407,
    "text": "确认第三处干地：未完成",
    "turn": 1
  },
  {
    "code": "F43",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 407,
    "text": "南船口、中央转运岛、东北古道高地各\n有完整干岸，三处确认点沿接应路线依\n次推进；居民从正式队员后方出发。",
    "turn": 1
  },
  {
    "code": "F43",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 407,
    "text": "真正水沟把撤离主线收束到两段高木\n栈，桥端均落在干岛；毒沼集中在西侧\n与东南侧，不把泥沼伪装成安全道路。",
    "turn": 1
  },
  {
    "code": "F43",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 407,
    "text": "西侧湿地小桥可分队压制术士并接近北\n祭台，离开护送线须承担沼泽与孤军风\n险；主队可沿中央便桥保护居民。",
    "turn": 1
  },
  {
    "code": "F43",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 407,
    "text": "神官区域保留固定(26,6)召唤源及空\n余生成格，原第三回合最多三召唤物、\n击败神官只移除指定召唤物、至少两组",
    "turn": 1
  },
  {
    "code": "F43",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 407,
    "text": "撤离规则不变。",
    "turn": 1
  },
  {
    "code": "F43",
    "kind": "dialogue_or_objective",
    "speaker": "神官",
    "stage": 407,
    "text": "让亡潮守住古道。",
    "turn": 3
  },
  {
    "code": "F43",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 407,
    "text": "这些召唤物与神官相连；天然魔物不会\n随他退去。",
    "turn": 3
  },
  {
    "code": "F43",
    "kind": "dialogue_or_objective",
    "speaker": "居民",
    "stage": 407,
    "text": "接应的人到了。我们先到安\n全处等候。",
    "turn": 18
  },
  {
    "code": "F43",
    "kind": "dialogue_or_objective",
    "speaker": "船团医者",
    "stage": 407,
    "text": "获救居民已逐组交接。古道\n通向祭所，船口还收到孤岛\n的求援。",
    "turn": 19
  },
  {
    "code": "F43",
    "kind": "dialogue_or_objective",
    "speaker": "船团医者",
    "stage": 407,
    "text": "居民已按实际获救名单交\n接，船分批运送，不占正式\n成员的物品槽。",
    "turn": 19
  },
  {
    "code": "F43",
    "kind": "dialogue_or_objective",
    "speaker": "舵手",
    "stage": 407,
    "text": "古道连接沉没祭所。西南孤\n岛还有两组病人等待接应。",
    "turn": 19
  },
  {
    "code": "F43",
    "kind": "dialogue_or_objective",
    "speaker": "舵手",
    "stage": 407,
    "text": "赛琳留在沼泽孤岛守着两组\n病人。支路从这里分开，船\n可以在西南木台靠岸。",
    "turn": 19
  },
  {
    "code": "F43",
    "kind": "dialogue_or_objective",
    "speaker": "舵手",
    "stage": 407,
    "text": "岛上守船人还保管着雾中护\n航用的定潮枪。先把病人安\n置好，他会把旧枪交给继续",
    "turn": 19
  },
  {
    "code": "F43",
    "kind": "dialogue_or_objective",
    "speaker": "舵手",
    "stage": 407,
    "text": "守路的人。",
    "turn": 19
  },
  {
    "code": "F44",
    "kind": "dialogue_or_objective",
    "speaker": "艾琳",
    "stage": 408,
    "text": "三个调节点都要交给工匠，\n正式队员可以继续向前。先\n做局部隔离试验，再等两岸",
    "turn": 1
  },
  {
    "code": "F44",
    "kind": "dialogue_or_objective",
    "speaker": "艾琳",
    "stage": 408,
    "text": "确认。",
    "turn": 1
  },
  {
    "code": "F44",
    "kind": "dialogue_or_objective",
    "speaker": "信使",
    "stage": 408,
    "text": "西队已切断投送站，本次不\n会有投送援军。",
    "turn": 1
  },
  {
    "code": "F44",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 408,
    "text": "交接三处调节点，保护工匠至下一回合\n并击败守兽。首领有橙色旗标。S菜单可\n定位首领。",
    "turn": 1
  },
  {
    "code": "F44",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 408,
    "text": "交接三处调节点，保护工匠至下一回合\n并击败守兽。",
    "turn": 1
  },
  {
    "code": "F44",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 408,
    "text": "投送援军已取消。三点交接后保护至下\n一己方回合，且至少一名工匠存活。",
    "turn": 1
  },
  {
    "code": "F44",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 408,
    "text": "交接中央调节点：未完成",
    "turn": 1
  },
  {
    "code": "F44",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 408,
    "text": "交接东调节点：未完成",
    "turn": 1
  },
  {
    "code": "F44",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 408,
    "text": "交接西调节点：未完成",
    "turn": 1
  },
  {
    "code": "F44",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 408,
    "text": "沉没祭所由西调节台、中央作业台、东\n调节台与北神门四处残存石台组成，水\n体贯穿其间；南接应台留出工匠棚和泊",
    "turn": 1
  },
  {
    "code": "F44",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 408,
    "text": "船位置。",
    "turn": 1
  },
  {
    "code": "F44",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 408,
    "text": "南侧双格便桥可直接进入中央作业台，\n西侧长桥通往旧石拱，再经一格短桥侧\n接中央；东桥连接独立援军平台，北方",
    "turn": 1
  },
  {
    "code": "F44",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 408,
    "text": "另有两条接近神门的维护线。",
    "turn": 1
  },
  {
    "code": "F44",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 408,
    "text": "三处设备各有可站交接点和完整岸上落\n脚面，工匠位于南侧与中央后方；三点\n交接后等待到下一己方回合、至少一名",
    "turn": 1
  },
  {
    "code": "F44",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 408,
    "text": "工匠存活及投送切断入场快照均保持。",
    "turn": 1
  },
  {
    "code": "F44",
    "kind": "dialogue_or_objective",
    "speaker": "工匠",
    "stage": 408,
    "text": "三个调节点已接通。再保护\n到下一己方回合，完成局部\n隔离试验。",
    "turn": 20
  },
  {
    "code": "F44",
    "kind": "dialogue_or_objective",
    "speaker": "技术员",
    "stage": 408,
    "text": "局部隔离试验成功。再到调\n节庭核对西塔停用后的灯\n光，不能把局部成功当成两",
    "turn": 21
  },
  {
    "code": "F44",
    "kind": "dialogue_or_objective",
    "speaker": "技术员",
    "stage": 408,
    "text": "岸验证。",
    "turn": 21
  },
  {
    "code": "F44",
    "kind": "dialogue_or_objective",
    "speaker": "旁白",
    "stage": 408,
    "text": "战后整理出银弓，已收入本队行囊，可\n在部队整备中分配。",
    "turn": 21
  },
  {
    "code": "F44",
    "kind": "dialogue_or_objective",
    "speaker": "地方技术员",
    "stage": 408,
    "text": "局部隔离试验已成功。三个\n调节点由留守工匠接手，不\n需要远征队一直站在那里。",
    "turn": 21
  },
  {
    "code": "F44",
    "kind": "dialogue_or_objective",
    "speaker": "艾琳",
    "stage": 408,
    "text": "先保护住这里的人。等西塔\n也安全停下，再读两岸的确\n认信。",
    "turn": 21
  },
  {
    "code": "F44",
    "kind": "dialogue_or_objective",
    "speaker": "旁白",
    "stage": 408,
    "text": "艾琳进阶为引光剑使，基础移动提升至\n5，按最低基底补足属性与抗性。等级、\n经验、当前生命和原有法术训练保留。",
    "turn": 21
  },
  {
    "code": "F44",
    "kind": "dialogue_or_objective",
    "speaker": "旁白",
    "stage": 408,
    "text": "术法精熟使已学攻击法术每次减耗1生\n命，正费用最低为1；辅助法术费用不\n变。试验不代替同伴救治。",
    "turn": 21
  },
  {
    "code": "F44",
    "kind": "dialogue_or_objective",
    "speaker": "工匠",
    "stage": 408,
    "text": "祭所封存的引光剑已经修\n好。艾琳，交给你。让它跟\n着你们，保护还在路上的",
    "turn": 21
  },
  {
    "code": "F44",
    "kind": "dialogue_or_objective",
    "speaker": "工匠",
    "stage": 408,
    "text": "人。",
    "turn": 21
  },
  {
    "code": "F44",
    "kind": "dialogue_or_objective",
    "speaker": "旁白",
    "stage": 408,
    "text": "引光剑供艾琳使用，对指定魔物有效，\n并在阶段开始时恢复生命；不需要它也\n能完成终战。",
    "turn": 21
  },
  {
    "code": "F44",
    "kind": "dialogue_or_objective",
    "speaker": "旁白",
    "stage": 408,
    "text": "守途兵装 · 引光剑已收入东队行囊，\n可在部队整备中分配。",
    "turn": 21
  },
  {
    "code": "F44",
    "kind": "dialogue_or_objective",
    "speaker": "地方技术员",
    "stage": 408,
    "text": "日塔那边停了。这里的灯还\n亮着。",
    "turn": 21
  },
  {
    "code": "F44",
    "kind": "dialogue_or_objective",
    "speaker": "艾琳",
    "stage": 408,
    "text": "再看一会儿。别急着把船叫\n回来。",
    "turn": 21
  },
  {
    "code": "F44",
    "kind": "dialogue_or_objective",
    "speaker": "船团医者",
    "stage": 408,
    "text": "岸边的人已经看见了。有人\n在问，今晚能不能住在自己\n家里。",
    "turn": 21
  },
  {
    "code": "F44",
    "kind": "dialogue_or_objective",
    "speaker": "艾琳",
    "stage": 408,
    "text": "先让修塔的人检查。等他们\n说可以，我们再去告诉大\n家。",
    "turn": 21
  },
  {
    "code": "F44",
    "kind": "dialogue_or_objective",
    "speaker": "技术员",
    "stage": 408,
    "text": "两岸的读数稳定，居民可以\n回到已经检查过的房屋。",
    "turn": 21
  },
  {
    "code": "F44",
    "kind": "dialogue_or_objective",
    "speaker": "运输人员",
    "stage": 408,
    "text": "最后一份救治材料送往会合\n营站。伤者会与我们一起转\n移，不会被留在这里。",
    "turn": 21
  },
  {
    "code": "S41",
    "kind": "dialogue_or_objective",
    "speaker": "奥托",
    "stage": 411,
    "text": "名字都在村中那间屋里。他\n们说要把村里腾空。",
    "turn": 1
  },
  {
    "code": "S41",
    "kind": "dialogue_or_objective",
    "speaker": "胡纳普",
    "stage": 411,
    "text": "先护住名册屋。屋在村道东\n侧，门朝南。",
    "turn": 1
  },
  {
    "code": "S41",
    "kind": "dialogue_or_objective",
    "speaker": "保管人",
    "stage": 411,
    "text": "烧毁前保护黑钟村名册，确\n认避难院，再击败焚毁队长\n并胜利；回黑钟村避难院找",
    "turn": 1
  },
  {
    "code": "S41",
    "kind": "dialogue_or_objective",
    "speaker": "保管人",
    "stage": 411,
    "text": "保管人，可领取续愿戒。不\n必删去凯尔做过的错事。",
    "turn": 1
  },
  {
    "code": "S41",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 411,
    "text": "击败焚毁队长；尽力保护名册，失去记\n录不阻断主线。首领有橙色旗标。S菜单\n可定位首领。",
    "turn": 1
  },
  {
    "code": "S41",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 411,
    "text": "击败焚毁队长；尽力保护名册，失去记\n录不阻断主线。",
    "turn": 1
  },
  {
    "code": "S41",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 411,
    "text": "焚毁兵连续两次在门前点火才毁记录。\n第5回合开始，提前一回合预告。",
    "turn": 1
  },
  {
    "code": "S41",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 411,
    "text": "保护黑钟村名册：未完成",
    "turn": 1
  },
  {
    "code": "S41",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 411,
    "text": "雪山村落沿钟楼主街展开，东侧名册屋\n门朝南，西南医舍与避难院在队伍后\n方；雪林和连片岩坡界定村缘。",
    "turn": 1
  },
  {
    "code": "S41",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 411,
    "text": "主街尽快接近名册屋，东坡小路是焚毁\n兵实际来路，南侧住屋旁有回村支线；\n屋门操作格与焚毁目标完全重合。",
    "turn": 1
  },
  {
    "code": "S41",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 411,
    "text": "焚毁兵第5回合出发、前一回合预告、连\n续两次点火才毁册不变；从东坡到南门\n有实际路程供拦截，名册损失仍不阻断",
    "turn": 1
  },
  {
    "code": "S41",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 411,
    "text": "主线。",
    "turn": 1
  },
  {
    "code": "S41",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 411,
    "text": "焚毁兵下一回合出发，目标是记录室南\n门。需要连续两次点火才能焚毁。",
    "turn": 4
  },
  {
    "code": "S41",
    "kind": "dialogue_or_objective",
    "speaker": "村民",
    "stage": 411,
    "text": "这张军令上有凯尔的名字。\n他起初也执行迁徙命令，后\n来见到孩子被押走，才违令",
    "turn": 4
  },
  {
    "code": "S41",
    "kind": "dialogue_or_objective",
    "speaker": "村民",
    "stage": 411,
    "text": "救人。",
    "turn": 4
  },
  {
    "code": "S41",
    "kind": "dialogue_or_objective",
    "speaker": "胡纳普",
    "stage": 411,
    "text": "把前后都留下。他救过人，\n也确实参与过这些事。",
    "turn": 4
  },
  {
    "code": "S41",
    "kind": "dialogue_or_objective",
    "speaker": "村民",
    "stage": 411,
    "text": "完整名册保住了，军令的前\n后都记下了。",
    "turn": 10
  },
  {
    "code": "S41",
    "kind": "dialogue_or_objective",
    "speaker": "旁白",
    "stage": 411,
    "text": "战后整理出银弓，已收入本队行囊，可\n在部队整备中分配。",
    "turn": 10
  },
  {
    "code": "S41",
    "kind": "dialogue_or_objective",
    "speaker": "村民",
    "stage": 411,
    "text": "完整名册已经存档。凯尔先\n执行迁徙、后违令救人的前\n后记录都留下了。",
    "turn": 10
  },
  {
    "code": "S41",
    "kind": "dialogue_or_objective",
    "speaker": "胡纳普",
    "stage": 411,
    "text": "我还是想知道他最后看见了\n什么。但不能只记我愿意相\n信的那一面。",
    "turn": 10
  },
  {
    "code": "S42",
    "kind": "dialogue_or_objective",
    "speaker": "赛琳",
    "stage": 412,
    "text": "我不能把病人留在这里。你\n们有能靠岸的船吗？",
    "turn": 1
  },
  {
    "code": "S42",
    "kind": "dialogue_or_objective",
    "speaker": "艾琳",
    "stage": 412,
    "text": "船在西南，先守住诊疗处，\n让两组病人依次上船。",
    "turn": 1
  },
  {
    "code": "S42",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 412,
    "text": "北端飞行敌第3回合开始压近。先接住病\n人，不要直接冲向北面的队长。",
    "turn": 1
  },
  {
    "code": "S42",
    "kind": "dialogue_or_objective",
    "speaker": "赛琳",
    "stage": 412,
    "text": "北端那只骸翼兽会近身撕\n咬、两格蚀息。它也从第3回\n合压近，先把病人送向西南",
    "turn": 1
  },
  {
    "code": "S42",
    "kind": "dialogue_or_objective",
    "speaker": "赛琳",
    "stage": 412,
    "text": "船边。",
    "turn": 1
  },
  {
    "code": "S42",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 412,
    "text": "确认船口、护送两组病人撤离并击败清\n洗队长。出口有旗标。S菜单可定位出口\n与首领。",
    "turn": 1
  },
  {
    "code": "S42",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 412,
    "text": "确认船口、护送两组病人撤离并击败清\n洗队长。",
    "turn": 1
  },
  {
    "code": "S42",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 412,
    "text": "已撤离0组；至少2组。居民遇敌等待，\n请清出连续通路；组别生死分别保存。",
    "turn": 1
  },
  {
    "code": "S42",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 412,
    "text": "确认船边接应点：未完成",
    "turn": 1
  },
  {
    "code": "S42",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 412,
    "text": "诊疗屋、井台、药车和照护住屋组成南\n岸医疗院；两组病人位于护卫队后方，\n南侧转运路直接通西南接应船，不穿北",
    "turn": 1
  },
  {
    "code": "S42",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 412,
    "text": "端敌阵。",
    "turn": 1
  },
  {
    "code": "S42",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 412,
    "text": "主木桥形成可保护诊疗处的前沿，东侧\n窄栈可绕到北端守军侧面；两桥完整跨\n过真实水沟，两端都有落脚地。",
    "turn": 1
  },
  {
    "code": "S42",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 412,
    "text": "北端三名飞行敌保留第3回合压近时机，\n玩家需要先接住病人并守住诊疗院；赛\n琳留在院内，航行记录就在诊疗屋南",
    "turn": 1
  },
  {
    "code": "S42",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 412,
    "text": "门。",
    "turn": 1
  },
  {
    "code": "S42",
    "kind": "dialogue_or_objective",
    "speaker": "战场提示",
    "stage": 412,
    "text": "必须让两组病人存活并撤离、确认船边\n接应点并击败队长；赛琳生死与后续邀\n请原样记录，保留单格恢复点。",
    "turn": 1
  },
  {
    "code": "S42",
    "kind": "dialogue_or_objective",
    "speaker": "居民",
    "stage": 412,
    "text": "接应的人到了。我们先到安\n全处等候。",
    "turn": 7
  },
  {
    "code": "S42",
    "kind": "dialogue_or_objective",
    "speaker": "医者",
    "stage": 412,
    "text": "两组病人已上船，地方医者\n会接手。到诊疗处与赛琳交\n谈，再决定是否同行。",
    "turn": 12
  },
  {
    "code": "S42",
    "kind": "dialogue_or_objective",
    "speaker": "舵手",
    "stage": 412,
    "text": "获救的病人已经安置好了。\n这把定潮枪曾在雾中护送船\n队，现在交给你们继续守",
    "turn": 12
  },
  {
    "code": "S42",
    "kind": "dialogue_or_objective",
    "speaker": "舵手",
    "stage": 412,
    "text": "路。",
    "turn": 12
  },
  {
    "code": "S42",
    "kind": "dialogue_or_objective",
    "speaker": "旁白",
    "stage": 412,
    "text": "守途兵装 · 定潮枪已收入东队行囊，\n可在部队整备中分配。",
    "turn": 12
  },
  {
    "code": "S42",
    "kind": "dialogue_or_objective",
    "speaker": "旁白",
    "stage": 412,
    "text": "战后整理出圣剑，已收入本队行囊，可\n在部队整备中分配。",
    "turn": 12
  },
  {
    "code": "S42",
    "kind": "dialogue_or_objective",
    "speaker": "赛琳",
    "stage": 412,
    "text": "两组病人都安置好了，地方\n医者会留下。我可以跟你们\n同行，照护后面的船。",
    "turn": 12
  },
  {
    "code": "S42",
    "kind": "dialogue_or_objective",
    "speaker": "艾琳",
    "stage": 412,
    "text": "把交接记清楚，你也不必一\n个人负责所有人。",
    "turn": 12
  },
  {
    "code": "S42",
    "kind": "dialogue_or_objective",
    "speaker": "地方医者",
    "stage": 412,
    "text": "维娅当年急着证明航线，船\n还没备齐就出海。有几条船\n再也没有回来。",
    "turn": 12
  },
  {
    "code": "S42",
    "kind": "dialogue_or_objective",
    "speaker": "艾琳",
    "stage": 412,
    "text": "把失去的人和后来获救的人\n都留下。她救过我，我也不\n能替她删掉那些名字。",
    "turn": 12
  }
