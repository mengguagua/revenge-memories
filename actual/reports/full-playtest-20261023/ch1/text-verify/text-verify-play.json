      "safe_area_pixels": [
        212.0,
        48.0
      ],
      "speaker": "战场提示",
      "stage": 105,
      "text": "东侧木栈道通向北门退路，可提前派骑\n兵拦截。用 S 菜单定位出口和首领。",
      "text_pixels": [
        204.0,
        28.0
      ],
      "view": "plot"
