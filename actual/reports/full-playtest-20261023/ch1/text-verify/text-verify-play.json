      "layout_ok": true,
      "safe_area_pixels": [
        212.0,
        48.0
      ],
      "speaker": "战场提示",
      "stage": 105,
      "text": "回合半血撤离，最晚第8回合；沿东侧栈\n道尽头封住北门退路。",
      "text_pixels": [
        212.0,
        28.0
