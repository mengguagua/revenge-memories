  "scenes": {
    "D00": [
      {
        "speaker": "胡纳普",
        "text": "艾琳？……真的是你？"
      },
      {
        "speaker": "艾琳",
        "text": "胡纳普……"
      },
      {
        "speaker": "胡纳普",
        "text": "放开她！"
      },
      {
        "speaker": "赫兰",
        "text": "胡纳普，她拆了传光台的封印。"
      },
      {
        "speaker": "艾琳",
        "text": "让开！赫兰，停下仪式！"
      },
      {
        "speaker": "艾琳",
        "text": "胡纳普，为什么挡我？"
      },
      {
        "speaker": "胡纳普",
        "text": "艾琳，你这是做什么？"
      },
      {
        "speaker": "艾琳",
        "text": "他要把船上的人送回海上！"
      },
      {
        "speaker": "赫兰",
        "text": "我已经让人安置他们。"
      },
      {
        "speaker": "胡纳普",
        "text": "那是哪里？"
      },
      {
        "speaker": "艾琳",
        "text": "东群岛！他们还没撤出来！"
      },
      {
        "speaker": "胡纳普",
        "text": "先停手。"
      }
    ],
    "D11": [
      {
        "speaker": "胡纳普",
        "text": "哥，我相信不是你的错，明天我就出发。"
      },
      {
        "speaker": "达恩",
        "text": "你真想好了？凯尔的名字还没刻完。"
      },
      {
        "speaker": "胡纳普",
        "text": "回来再刻。被抓去服役的村民回来了。黑铠将军·科兰却说他通敌，把他杀了……"
      },
      {
        "speaker": "达恩",
        "text": "别去硬闯。先到丘堡粮站问问，兴许能找到证据。"
      },
      {
        "speaker": "胡纳普",
        "text": "好，明天走林路。你把弓带上。"
      }
    ],
    "D12": [
      {
        "speaker": "胡纳普",
        "text": "赫兰大人？我叫胡纳普，来自雪原村。"
      },
      {
        "speaker": "赫兰",
        "text": "粮站的信里提过你。"
      },
      {
        "speaker": "胡纳普",
        "text": "这是在押送所找到的名单。救出来的村民说，另一批村民被强押去海峡城修城墙。"
      },
      {
        "speaker": "赫兰",
        "text": "蕾娜被抓前写过信。我派人去讨粮、要人。科兰竟然攻击教团。"
      },
      {
        "speaker": "胡纳普",
        "text": "您的话，他们也不听？"
      },
      {
        "speaker": "赫兰",
        "text": "守堡的护日军只听黑铠将军·科兰。王都让他守港，让我主持日返仪式。"
      },
      {
        "speaker": "胡纳普",
        "text": "我去海峡城接人。还有这份军令，强押村民是军队的错，科兰却杀了放人的凯尔。"
      },
      {
        "speaker": "赫兰",
        "text": "我会让记录官证明。"
      },
      {
        "speaker": "赫兰",
        "text": "兰斯，旧塔外营你带他们进去，帮助他们。"
      },
      {
        "speaker": "兰斯",
        "text": "是，大人。"
      },
      {
        "speaker": "医者",
        "text": "我这里有一份泉液。有人濒死，就抬过来医治。"
      },
      {
        "speaker": "胡纳普",
        "text": "要是我哥那天也有这药……"
      },
      {
        "speaker": "界面提示",
        "text": "濒死同伴仍留队接受照护，暂不能出阵。泉液可救治一名濒死同伴，未用时保留，每人只能接受一次救治。"
      }
    ],
    "D13": [
      {
        "speaker": "胡纳普",
        "text": "你命令凯尔回营，答应过不追究。"
      },
      {
        "speaker": "科兰",
        "text": "他私自放人，违反军令。"
      },
      {
        "speaker": "胡纳普",
        "text": "所以你把他吊在营门外。"
      },
      {
        "speaker": "科兰",
        "text": "敢违令，就得死。"
      },
      {
        "speaker": "胡纳普",
        "text": "你之前命令军队强押村民，妄杀凯尔，现在叫部下死守，自己却要趁机撤退。"
      },
      {
        "speaker": "旁白",
        "text": "胡纳普挥下最后一击。"
      },
      {
        "speaker": "科兰",
        "text": "不……我不能死在这里……"
      },
      {
        "speaker": "胡纳普",
        "text": "哥哥……"
      }
    ],
    "D21": [
      {
        "speaker": "卡洛",
        "text": "艾琳，我在外岛码头看见你母亲船上的舵手。他戴着镣铐，被押上潮狩军的船。"
      },
      {
        "speaker": "艾琳",
        "text": "你没认错？"
      },
      {
        "speaker": "卡洛",
        "text": "不会错，你母亲雇佣我，我们一起出海，他也在船。"
      },
      {
        "speaker": "艾琳",
        "text": "母亲失踪以后，我来找过你。你怎么不在船上，也没回来？"
      },
      {
        "speaker": "卡洛",
        "text": "哈哈，你知道的，我喜欢玩骰子，听说债主在下一港口堵我。我就在前一站下船了。后来在外岛接了个长途护送的活，回来才知道薇娅出事。今天见到舵手，就赶回来找你。"
      },
      {
        "speaker": "艾琳",
        "text": "他或许知道我母亲在哪。潮狩军的船往哪边走了？"
      },
      {
        "speaker": "卡洛",
        "text": "押送舰往外海去了。我带你去找。"
      },
      {
        "speaker": "艾琳",
        "text": "我去码头找马丁船长。"
      },
      {
        "speaker": "马丁",
        "text": "艾琳，学舍又有药要往外岛送？"
      },
      {
        "speaker": "艾琳",
        "text": "这次是我想请你帮忙。卡洛看见我母亲的舵手被押上了潮狩军的船。"
      },
      {
        "speaker": "马丁",
        "text": "你母亲以前替我的船领过路。她没回来我也很担心。"
      },
      {
        "speaker": "艾琳",
        "text": "我想追上去。那艘舰往外海开了，卡洛会带路。"
      },
      {
        "speaker": "马丁",
        "text": "没问题，上船吧。不过我和船员不擅长战斗，其它的帮不上。"
      }
    ],
    "D22_FIRST": [
      {
        "speaker": "艾琳",
        "text": "你还记得薇娅吗？她以前给你的船送过药。"
      },
      {
        "speaker": "裴萨",
        "text": "记得。出事那天，我劝过她回头。"
      }
    ],
    "D22_DEFEAT": [
      {
        "speaker": "艾琳",
        "text": "活下来的人说，你的船追上来就放箭。谁下的令？"
      },
      {
        "speaker": "裴萨",
        "text": "教团叫我拦船。放箭是我下的令。"
      },
      {
        "speaker": "艾琳",
        "text": "你知道她在送伤者？"
      },
      {
        "speaker": "裴萨",
        "text": "知道。放她过去，别的船也会跟着走。王都扣了粮药，这一港的人怎么办？"
      },
      {
        "speaker": "艾琳",
        "text": "她的航图在哪儿？"
      }
    ],
    "D22": [
      {
        "speaker": "艾琳",
        "text": "我母亲的船上有你认识的人。她上次还替你带过药。"
      },
      {
        "speaker": "裴萨",
        "text": "我劝过她回去。她偏要把船开到神幕边上。"
      },
      {
        "speaker": "艾琳",
        "text": "所以你连伤者的船也不放过？"
      },
      {
        "speaker": "裴萨",
        "text": "船一旦过去，后面的人就都会跟着过去。"
      },
      {
        "speaker": "艾琳",
        "text": "她留下的航图在哪里？"
      },
      {
        "speaker": "旁白",
        "text": "裴萨指向主楼的神教箱。牢门边传来船员的呼喊，撤离还没有结束。"
      }
    ],
    "F25_MYTH": [
      {
        "speaker": "艾琳",
        "text": "是母亲的字。这个日期，是她最后出海那天。"
      },
      {
        "speaker": "艾琳",
        "text": "她记下的这两座岛挨得很近，那天只有一座见着太阳。"
      },
      {
        "speaker": "军港引航者",
        "text": "这是王都教团给裴萨的禁航令。没有许可，不准西渡。日光往哪里送，也由神决定。"
      },
      {
        "speaker": "军港引航者",
        "text": "这张是领货单。伪泰坦傀儡从盐原邦研究院运来，潮狩军收的。"
      },
      {
        "speaker": "艾琳",
        "text": "海灯岛的人说的也是那里。单子带上。"
      },
      {
        "speaker": "马丁",
        "text": "还有最近的航灯记录，好几座岛都在变暗。你母亲这张图上有条绕过去的路。"
      },
      {
        "speaker": "船医",
        "text": "船上的药只能撑一阵。那几处重伤，还是要去海峡城治。"
      },
      {
        "speaker": "艾琳",
        "text": "她把断航古道的石门画在这里了。马丁，看看还能不能过去。"
      }
    ],
    "D26_ARRIVAL": [
      {
        "speaker": "码头守卫",
        "text": "你可以上岸递文书，船留在外面。"
      },
      {
        "speaker": "艾琳",
        "text": "船上有人要用药。先让医者过来。"
      },
      {
        "speaker": "码头守卫",
        "text": "王都没准他们进城。查完船就拖回去。"
      },
      {
        "speaker": "艾琳",
        "text": "谁能下令留下船？"
      },
      {
        "speaker": "码头守卫",
        "text": "赫兰大人在广场。他要主持今天的日返，没空见你。"
      },
      {
        "speaker": "艾琳",
        "text": "胡纳普也在……让我进去，我要见赫兰。"
      },
      {
        "speaker": "教团守卫",
        "text": "等仪式结束。"
      },
      {
        "speaker": "艾琳",
        "text": "等到那时，船已经被拖走了！"
      },
      {
        "speaker": "赫兰",
        "text": "把她拦住。"
      },
      {
        "speaker": "艾琳",
        "text": "海上还有人。让船留下，先接伤者！"
      },
      {
        "speaker": "赫兰",
        "text": "伤者已经安排在码头院里。把她带到台前，船的事等仪式结束再说。"
      }
    ],
    "D31": [
      {
        "speaker": "胡纳普",
        "text": "先别动手！让她把话说完。"
      },
      {
        "speaker": "艾琳",
        "text": "赫兰，码头的院子里没有足够的药。你说的安置，是把人关在那里吗？"
      },
      {
        "speaker": "赫兰",
        "text": "我让他们等在院里。我以为仪式过后，就能安排上岸。"
      },
      {
        "speaker": "乌库布·卡基",
        "text": "艾琳。那年你摔伤了腿，是你母亲背着你离开的。"
      },
      {
        "speaker": "艾琳",
        "text": "她后来送伤者来求医，裴萨不准过，还向她的船放箭。"
      },
      {
        "speaker": "乌库布·卡基",
        "text": "我让她留在受保护的海面。她没有听。"
      },
      {
        "speaker": "艾琳",
        "text": "这些航灯记录都在。岛上早就开始变暗了，昨天的日返还没举行。"
      },
      {
        "speaker": "乌库布·卡基",
        "text": "给西岸准备日返时，已经开始调光。大典以后，供给才能稳下来。"
      },
      {
        "speaker": "胡纳普",
        "text": "堡里得到的日光，也是从那边调来的？"
      },
      {
        "speaker": "乌库布·卡基",
        "text": "是。西岸的田地要先保住，才有粮养活迁来的人。"
      },
      {
        "speaker": "胡纳普",
        "text": "那先让这些伤者上岸。"
      },
      {
        "speaker": "乌库布·卡基",
        "text": "西岸能接多少人，大典以后再定。现在把船送回去。"
      },
      {
        "speaker": "艾琳",
        "text": "船上有人今晚就撑不住了。"
      },
      {
        "speaker": "赫兰",
        "text": "这边的村子也刚见着太阳。等大典办完，我会派船。"
      },
      {
        "speaker": "胡纳普",
        "text": "她说的是今晚！先把伤者接上岸！"
      },
      {
        "speaker": "守卫",
        "text": "雷蒙统帅，西街的人也在往码头去。"
      },
      {
        "speaker": "雷蒙",
        "text": "护日军听令！封西街和码头。挡路的拿下，船都扣住。"
      },
      {
        "speaker": "胡纳普",
        "text": "西街还有人，我去接他们。"
      },
      {
        "speaker": "艾琳",
        "text": "我回码头。"
      }
    ],
    "D32": [
      {
        "speaker": "留守医者",
        "text": "人交给我吧，船医也会留下。缺药了，我再给你们送信。"
      },
      {
        "speaker": "胡纳普",
        "text": "你去过眠谷吗？"
      },
      {
        "speaker": "艾琳",
        "text": "到了山口。东边的路已经不在了。"
      },
      {
        "speaker": "胡纳普",
        "text": "我记得你家门前有棵树。"
      },
      {
        "speaker": "艾琳",
        "text": "母亲也记得。她在航图旁边还画过。"
      },
      {
        "speaker": "胡纳普",
        "text": "我本来想带你回去看看。"
      },
      {
        "speaker": "艾琳",
        "text": "先让他们停下往西调光吧。屋子还在往海里倒。"
      },
      {
        "speaker": "胡纳普",
        "text": "西边也有人靠它过冬。现在停了，那些人怎么办？"
      },
      {
        "speaker": "艾琳",
        "text": "那我要等多久？"
      },
      {
        "speaker": "胡纳普",
        "text": "我不知道。先找懂这些装置的人。塔不能就这么拆了。"
      },
      {
        "speaker": "运输工",
        "text": "修北境日塔的人还关在军需大道的车里。工具都收到沿海石堡去了。"
      },
      {
        "speaker": "胡纳普",
        "text": "我去把他们接出来，问清还能怎么办。"
      },
      {
        "speaker": "艾琳",
        "text": "军港这张单子写着研究院。那里的病人也在等人接。我从盐路去，母亲标过沿途的港口。"
      },
      {
        "speaker": "胡纳普",
        "text": "查到什么就写信。遇上麻烦也告诉我。"
      },
      {
        "speaker": "艾琳",
        "text": "你也一样。我在东边等你的信。"
      }
    ],
    "D33": [
      {
        "speaker": "马丁",
        "text": "眼下只护住这一段渡口。能分批接人，外头那些港还是不放船。"
      },
      {
        "speaker": "工匠",
        "text": "两本账对上了。这张图是断裂以前的，各地原来都有能自己调节的装置。"
      },
      {
        "speaker": "术士",
        "text": "后来也出过事。剩下这几页没写清怎么换接，完整的在盐原观测台。"
      },
      {
        "speaker": "胡纳普",
        "text": "有位工匠回乡了。他孩子还在等他。留下的人手不多，有些地方现在修不了。"
      },
      {
        "speaker": "艾琳",
        "text": "院里也有人不愿走，还想接着治。我给他们留了药。可海上的人也不能一直等。"
      },
      {
        "speaker": "胡纳普",
        "text": "我去查北村。能少引些光，就先少引些。停塔还要再等等。"
      },
      {
        "speaker": "艾琳",
        "text": "我去观测台。哪些地方停不得，也写给你。"
      },
      {
        "speaker": "信使",
        "text": "雪峡村南口封了，还有人下不了山。"
      },
      {
        "speaker": "胡纳普",
        "text": "我去接他们。愿意帮忙的工匠跟车走。"
      },
      {
        "speaker": "艾琳",
        "text": "我先去沙城找玛尔塔，让她撤掉征调令，再去观测台。"
      },
      {
        "speaker": "胡纳普",
        "text": "观测台有守军，多带几个护卫。"
      },
      {
        "speaker": "艾琳",
        "text": "马丁安排好了。你去山里，医者也带上。"
      },
      {
        "speaker": "医者",
        "text": "这里新到一份泉液。教堂和灯屋余下的也运来了，需要时来找我。"
      },
      {
        "speaker": "界面提示",
        "text": "两队共用救治份额，同一伤者只能接受一次救治。"
      }
    ],
    "D41": [
      {
        "speaker": "赫兰",
        "text": "雪峡高处的人还在南口？我给北村的粮令已经盖了印。"
      },
      {
        "speaker": "胡纳普",
        "text": "有人愿意去你安排的地方，我已经派车送了。"
      },
      {
        "speaker": "赫兰",
        "text": "让大典办完，日光还能多给北村一些。他们不必一直挤在那儿。"
      },
      {
        "speaker": "胡纳普",
        "text": "那东边呢？"
      },
      {
        "speaker": "赫兰",
        "text": "先接名单上的船。西岸有多少粮、能住多少人，都要算进去。"
      },
      {
        "speaker": "胡纳普",
        "text": "我见过不在名单上的伤者。他们也要活。"
      },
      {
        "speaker": "赫兰",
        "text": "你那几处修好的设备，过得了冬吗？各村以后又各取各的，谁去救来不及走的人？"
      },
      {
        "speaker": "胡纳普",
        "text": "我不知道能不能过冬。工匠留下了，高处的人先住南口。这车粮已经送去港口。"
      },
      {
        "speaker": "胡纳普",
        "text": "先开港，跟我们一起接人。日塔也可以接着查。"
      },
      {
        "speaker": "赫兰",
        "text": "雷蒙把外门交给我，我答应保住大典。现在不能开。"
      },
      {
        "speaker": "胡纳普",
        "text": "那我们自己进去。"
      },
      {
        "speaker": "蕾娜",
        "text": "医舍旁的门留着。伤兵从那里走。"
      }
    ],
    "H01_DAAN_FIRST": [
      {
        "speaker": "胡纳普",
        "text": "你也跟我走？"
      },
      {
        "speaker": "达恩",
        "text": "当然。流亡的时候咱们一块儿过来的，这回也一起走。"
      },
      {
        "speaker": "达恩",
        "text": "我还想攒钱开家店。路过镇子，正好看看哪人多。"
      },
      {
        "speaker": "达恩",
        "text": "弓我带好了。奥托带路，咱们先去丘堡粮站。"
      }
    ],
    "H01_DAAN_REPEAT": [
      {
        "speaker": "达恩",
        "text": "弓我带好了。奥托带路，咱们先去丘堡粮站。"
      }
    ],
    "H08_BECK_FIRST": [
      {
        "speaker": "胡纳普",
        "text": "你不跟他们回村？"
      },
      {
        "speaker": "贝克",
        "text": "你们是去海峡城吧？让我也去。不能再让军队乱押人。"
      },
      {
        "speaker": "胡纳普",
        "text": "这一路很危险。你想好了？"
      },
      {
        "speaker": "贝克",
        "text": "想好了。"
      }
    ],
    "H08_BECK_DECLINE": [
      {
        "speaker": "贝克",
        "text": "也好。我先帮他们收拾。需要人手时，再来找我。"
      }
    ],
    "H08_BECK_REPEAT": [
      {
        "speaker": "贝克",
        "text": "我还想跟你们走。需要我帮忙吗？"
      }
    ],
    "H08_BECK_ACCEPT": [
      {
        "speaker": "胡纳普",
        "text": "那就一起走。"
      },
      {
        "speaker": "贝克",
        "text": "好！我的弓还能帮上忙。"
      }
    ],
    "H09_HERVI_ON_DUTY": [
      {
        "speaker": "赫维",
        "text": "药送来了，伤者没人接手。我走不开。"
      }
    ],
    "H09_HERVI_FIRST": [
      {
        "speaker": "胡纳普",
        "text": "诊所忙完了，你接下来去哪？"
      },
      {
        "speaker": "赫维",
        "text": "我想去海峡城那座塔看看，多学点术法，也看看那里的药店。村里每回缺药，都只能等教团送来。"
      },
      {
        "speaker": "赫维",
        "text": "这里有人接手。我能跟你们走一程吗？"
      }
    ],
    "H09_HERVI_DECLINE": [
      {
        "speaker": "赫维",
        "text": "也好。我先留在诊所。你们路上小心。"
      }
    ],
    "H09_HERVI_REPEAT": [
      {
        "speaker": "赫维",
        "text": "伤者有管理员照看。我现在能走。"
      }
    ],
    "H09_HERVI_JOINED": [
      {
        "speaker": "赫维",
        "text": "我想把沿路见到的法术和药方记下来，回村以后也用得上。"
      }
    ],
    "H09_HERVI_ACCEPT": [
      {
        "speaker": "胡纳普",
        "text": "那就一起走。"
      },
      {
        "speaker": "赫维",
        "text": "好。"
      }
    ],
    "S11_COMPANION_AFTER": [
      {
        "speaker": "贝克",
        "text": "都出来了……谢谢你们。我去看看伤着的那几个。"
      }
    ],
    "S12_COMPANION_AFTER": [
      {
        "speaker": "赫维",
        "text": "多谢。还有几个人在发热，我进去看看。"
      },
      {
        "speaker": "胡纳普",
        "text": "去吧。我们在院里等你。"
      }
    ],
    "M15_ESCAPE": [
      {
        "speaker": "科兰",
        "text": "趁现在，从北门走。"
      }
    ]
  },
