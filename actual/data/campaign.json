  "scenes": {
    "D00": [
      {
        "speaker": "赫兰",
        "text": "带她上来。有人说，她拆了传光台的封印。"
      },
      {
        "speaker": "胡纳普",
        "text": "……艾琳？把绳子解开。",
        "emotion": "concern"
      },
      {
        "speaker": "艾琳",
        "text": "胡纳普，退开。"
      },
      {
        "speaker": "胡纳普",
        "text": "你先告诉我发生了什么。",
        "emotion": "firm"
      },
      {
        "speaker": "艾琳",
        "text": "我在台下求过他们。一直等到现在。"
      },
      {
        "speaker": "赫兰",
        "text": "你船上的人已经送去安置。这里没有人要伤害你。"
      },
      {
        "speaker": "艾琳",
        "text": "他们要把船拖回海上。那里已经不能靠岸了。"
      }
    ],
    "D11": [
      {
        "speaker": "胡纳普",
        "text": "名字还没刻完。",
        "emotion": "grief"
      },
      {
        "speaker": "达恩",
        "text": "奥托说，要等村里的人都回来。还有几家认得你哥哥。"
      },
      {
        "speaker": "胡纳普",
        "text": "科兰回旧塔堡了。我明天走。",
        "emotion": "resolve"
      },
      {
        "speaker": "达恩",
        "text": "林路上那一队人怎么办？他们今天又被赶回来了。"
      },
      {
        "speaker": "胡纳普",
        "text": "……我先送他们出去。你把弓带上。",
        "emotion": "resolve"
      }
    ],
    "D12": [
      {
        "speaker": "赫兰",
        "text": "这批粮本来该送到你们村里。是我们没有送到。"
      },
      {
        "speaker": "胡纳普",
        "text": "科兰扣了粮，还把领粮的人抓走了。",
        "emotion": "anger"
      },
      {
        "speaker": "赫兰",
        "text": "我知道。蕾娜来信后，他把教堂的人也关了起来。"
      },
      {
        "speaker": "胡纳普",
        "text": "我会去旧塔堡。我要他说明凯尔的事。",
        "emotion": "resolve"
      },
      {
        "speaker": "赫兰",
        "text": "我派人与你一起去。塔里的劳工也请带回来。"
      }
    ],
    "D13": [
      {
        "speaker": "胡纳普",
        "text": "凯尔回营的时候，你答应过放人。",
        "emotion": "resolve"
      },
      {
        "speaker": "科兰",
        "text": "他已经把人放走了。他让整支军队看见，命令可以不听。"
      },
      {
        "speaker": "胡纳普",
        "text": "所以你把他挂在营门外。",
        "emotion": "anger"
      },
      {
        "speaker": "科兰",
        "text": "你若让他活着，下一个军官也会开门。"
      }
    ],
    "D21": [
      {
        "speaker": "艾琳",
        "text": "这块船牌，你留了两年？"
      },
      {
        "speaker": "卡洛",
        "text": "有人拿它抵债。我看见的时候，你母亲的船已经没了。"
      },
      {
        "speaker": "艾琳",
        "text": "那天你为什么不在船上？"
      },
      {
        "speaker": "卡洛",
        "text": "我提前走了。有人在下一座港口等我讨债。"
      },
      {
        "speaker": "艾琳",
        "text": "这次的船钱我付。到了押送舰，你带我上去。"
      },
      {
        "speaker": "卡洛",
        "text": "好。到了那里，我不会再先走。"
      }
    ],
    "D22_FIRST": [
      {
        "speaker": "艾琳",
        "text": "我母亲的船上有你认识的人。她上次还替你带过药。"
      },
      {
        "speaker": "裴萨",
        "text": "我劝过她回去。她偏要把船开到神幕边上。"
      },
      {
        "speaker": "艾琳",
        "text": "所以你连伤者的船也不放过？"
      },
      {
        "speaker": "裴萨",
        "text": "船一旦过去，后面的人就都会跟着过去。"
      }
    ],
    "D22_DEFEAT": [
      {
        "speaker": "艾琳",
        "text": "她留下的航图在哪里？"
      },
      {
        "speaker": "旁白",
        "text": "裴萨指向主楼的神教箱。牢门边传来船员的呼喊，撤离还没有结束。"
      }
    ],
    "D22": [
      {
        "speaker": "艾琳",
        "text": "我母亲的船上有你认识的人。她上次还替你带过药。"
      },
      {
        "speaker": "裴萨",
        "text": "我劝过她回去。她偏要把船开到神幕边上。"
      },
      {
        "speaker": "艾琳",
        "text": "所以你连伤者的船也不放过？"
      },
      {
        "speaker": "裴萨",
        "text": "船一旦过去，后面的人就都会跟着过去。"
      },
      {
        "speaker": "艾琳",
        "text": "她留下的航图在哪里？"
      },
      {
        "speaker": "旁白",
        "text": "裴萨指向主楼的神教箱。牢门边传来船员的呼喊，撤离还没有结束。"
      }
    ],
    "F25_MYTH": [
      {
        "speaker": "旁白",
        "text": "航图夹在七羽日冠的封印下。薇娅的边记记着：相邻两岛，曾在同一天得到不同的照明。"
      },
      {
        "speaker": "艾琳",
        "text": "这是母亲写的日期。那一天，我们的船还在这里。"
      },
      {
        "speaker": "引航者",
        "text": "命令也在箱里：禁止西渡，日光的转移交由神裁定。裴萨不是私下画的封航线。"
      },
      {
        "speaker": "艾琳",
        "text": "古道的石门还在图上。先把伤者带上船，再去西岸问清楚。"
      }
    ],
    "D26_ARRIVAL": [
      {
        "speaker": "旁白",
        "text": "船团终于抵达海峡城。广场正在为西大陆的日返举行庆典，船上的伤者仍在等候靠岸。"
      },
      {
        "speaker": "教团守卫",
        "text": "传光设施不得接近。破坏封印的人，带到台前。"
      },
      {
        "speaker": "艾琳",
        "text": "海上还有人。现在把船拖回去，他们没有地方停。"
      },
      {
        "speaker": "赫兰",
        "text": "先将她拘押。仪式结束后再安排船团。"
      },
      {
        "speaker": "旁白",
        "text": "艾琳在告示上看见了胡纳普的名字。那枚旧绳结仍系在她手上。"
      },
      {
        "speaker": "艾琳",
        "text": "胡纳普……你真的在这里？"
      },
      {
        "speaker": "旁白",
        "text": "广场的钟声响起。她被押到传光台前，故事回到庆典上的那一刻。"
      }
    ],
    "D31": [
      {
        "speaker": "旁白",
        "text": "现在，海峡城庆典。胡纳普伸出的手仍停在两人之间，海峡另一岸的船还在等待靠岸。"
      },
      {
        "speaker": "胡纳普",
        "text": "先住手。让她把话说完。"
      },
      {
        "speaker": "艾琳",
        "text": "这是母亲的航图和裴萨的军令。你们说海上已经没人，可船上的伤者还活着。"
      },
      {
        "speaker": "赫兰",
        "text": "我听说群岛还有居民。我以为神会给迁徙留出时间。"
      },
      {
        "speaker": "乌库布·卡基",
        "text": "艾琳。那年你摔伤了腿，是你母亲背着你离开的。"
      },
      {
        "speaker": "艾琳",
        "text": "她的船后来被截住了。"
      },
      {
        "speaker": "乌库布·卡基",
        "text": "我让她留在受保护的海面。她没有听。"
      },
      {
        "speaker": "胡纳普",
        "text": "那现在船上的人呢？他们留在那里也活不下去。"
      },
      {
        "speaker": "乌库布·卡基",
        "text": "庇护将继续集中于西大陆。把他们送回去，大典以后，西岸能够接收的人会被列出来。"
      },
      {
        "speaker": "艾琳",
        "text": "他们等不到大典。"
      },
      {
        "speaker": "赫兰",
        "text": "这里的村庄刚刚有了日光。我不能让仪式停下来。"
      },
      {
        "speaker": "胡纳普",
        "text": "我不能让你们把她送回正在崩坏的海面。"
      },
      {
        "speaker": "乌库布·卡基",
        "text": "拘押阻止仪式的人。大典将完成转移。"
      },
      {
        "speaker": "旁白",
        "text": "守卫封住传光台。西队沿西街救出居民，东队返回码头接应伤者。"
      }
    ],
    "D32": [
      {
        "speaker": "旁白",
        "text": "两队在城外旧街暂时会合。获救者已经交给留守医者。"
      },
      {
        "speaker": "胡纳普",
        "text": "你去过眠谷吗？"
      },
      {
        "speaker": "艾琳",
        "text": "到了山口。东边的路已经不在了。"
      },
      {
        "speaker": "胡纳普",
        "text": "我记得你家门前有一棵树。"
      },
      {
        "speaker": "艾琳",
        "text": "母亲也一直记得。她画航图的时候，还在旁边画过那棵树。"
      },
      {
        "speaker": "胡纳普",
        "text": "……我本来想带你回去看看。"
      },
      {
        "speaker": "艾琳",
        "text": "先把船上的人安置好吧。还有人在等我们。"
      },
      {
        "speaker": "胡纳普",
        "text": "我借日塔保住了村庄，不能让他们再受冻。"
      },
      {
        "speaker": "艾琳",
        "text": "我见过另一岸失去庇护。不能继续扩大转移。"
      },
      {
        "speaker": "胡纳普",
        "text": "那就先截住军路和原料。我去查石堡，把运走的工匠带回来。"
      },
      {
        "speaker": "艾琳",
        "text": "我沿母亲的航图去盐路和提炼院。把记录查清，再谈怎样停塔。"
      },
      {
        "speaker": "旁白",
        "text": "两队约定由固定信使传递消息，分别行动。"
      }
    ],
    "D33": [
      {
        "speaker": "工匠",
        "text": "石堡的投送记录与提炼院的调节记录相符。断裂以前，各地地脉会互相调节，不必把所有庇护集中在神幕。"
      },
      {
        "speaker": "术士",
        "text": "现在的土地已经依赖日塔。还要找到完整观测记录，验证停用办法，不能直接拆塔。"
      },
      {
        "speaker": "艾琳",
        "text": "这是观测台的位置。拿到完整记录，我就送信回来。"
      },
      {
        "speaker": "胡纳普",
        "text": "日塔还在给北面的村庄供光。我不能现在拆掉它。"
      },
      {
        "speaker": "艾琳",
        "text": "我知道了。要是不能安全停用，我会告诉你。"
      },
      {
        "speaker": "胡纳普",
        "text": "那里的守军也会看见你。别只带几个术士过去。"
      },
      {
        "speaker": "艾琳",
        "text": "船长已经安排好护卫。你也把医者留在能照顾到人的地方。"
      },
      {
        "speaker": "医者",
        "text": "营站收到一份救治泉液。教堂和灯屋尚未使用的份额也已运来，今后两队共用。每人仍只能接受一次救治。"
      },
      {
        "speaker": "旁白",
        "text": "营站成为共同补给与传信处。下一步，西队护住北境村庄，东队寻找安全停用的观测记录。"
      }
    ]
  },
