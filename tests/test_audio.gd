extends SceneTree

func _initialize() -> void:
	call_deferred("run")

func run() -> void:
	var script = load("res://core/original_audio.gd")
	assert(script != null)
	var audio = script.new()
	root.add_child(audio)
	await process_frame
	var music_id = audio._music_player.get_instance_id()
	var jingle_id = audio._jingle_player.get_instance_id()
	audio.play_music("battle")
	assert(audio._music_player.playing)
	assert(audio._music_player.stream.loop)
	assert(audio._music_player.stream.loop_offset > 0.0)
	await create_timer(0.05).timeout
	var before = audio._music_player.get_playback_position()
	audio.play_jingle("levelup")
	assert(audio._music_player.stream_paused)
	assert(audio._jingle_player.playing)
	assert(audio._jingle_active)
	audio.play_music("battle")
	assert(audio._music_player.get_playback_position() >= before)
	audio.set_music_enabled(false)
	assert(audio._jingle_player.stream_paused)
	assert(not audio.music_enabled)
	audio.set_music_enabled(true)
	assert(not audio._jingle_player.stream_paused)
	assert(audio._music_player.stream_paused)
	# Exercise the actual finished signal without waiting for the full short tune.
	audio._jingle_player.stop()
	audio._jingle_player.finished.emit()
	assert(not audio._music_player.stream_paused)
	assert(not audio._jingle_active)
	assert(audio._music_player.get_playback_position() >= before)
	assert(audio._music_player.get_instance_id() == music_id)
	assert(audio._jingle_player.get_instance_id() == jingle_id)
	audio.play_sfx("menu_confirm")
	assert(audio._sfx_players[0].playing or audio._sfx_players[1].playing)
	audio.set_sfx_enabled(false)
	assert(not audio._sfx_players[0].playing and not audio._sfx_players[1].playing)
	assert(not audio.sfx_enabled)
	audio.set_sfx_enabled(true)
	audio.play_sfx("attack")
	assert(not audio._sfx_players[0].playing and not audio._sfx_players[1].playing)
	audio.play_sfx("death")
	assert(not audio._sfx_players[0].playing and not audio._sfx_players[1].playing)
	audio.set_music_enabled(false)
	var paused_position = audio._music_player.get_playback_position()
	await create_timer(0.05).timeout
	assert(abs(audio._music_player.get_playback_position() - paused_position) < 0.02)
	audio.play_music("combat")
	assert(not audio._music_player.playing)
	assert(audio._music_pending_start)
	audio.set_music_enabled(true)
	assert(audio._music_player.playing and not audio._music_pending_start)
	assert(audio._music_player.get_playback_position() < 0.02)
	audio.set_volume(0.4)
	assert(abs(db_to_linear(audio._music_player.volume_db) - 0.2) < 0.0001)
	audio.stop_all()
	assert(not audio._music_player.playing and not audio._jingle_player.playing)
	assert(audio._music_player.stream == null and audio._jingle_player.stream == null)
	print("FE_ORIGINAL_AUDIO_CHECK_OK")
	audio.queue_free()
	await create_timer(0.15).timeout
	call_deferred("quit")
